process {
    withName: 'PRESERVE_SAMPLESHEET' {
        cpus = 1
        memory = '1 GB'
        disk = '1 GB'
        time = '1h'
    }

    withName: 'COLLATE_FASTQ' {
        cpus = 1
        memory = '2 GB'
        disk = '50 GB'
        time = '4h'
    }

    withName: 'VALIDATE_SRACHA_RUN' {
        cpus = 1
        memory = '1 GB'
        disk = '1 GB'
        time = '1h'
    }

    withName: 'DOWNLOAD_SRACHA_FASTQ' {
        cpus = 4
        memory = '4 GB'
        disk = '50 GB'
        time = '8h'
    }

    withName: 'DOWNLOAD_REFERENCE' {
        cpus = 1
        memory = '2 GB'
        disk = '50 GB'
        time = '8h'
    }

    withName: 'VERIFY_REFERENCE' {
        cpus = 1
        memory = '2 GB'
        disk = '20 GB'
        time = '4h'
    }

    withName: 'RECORD_REFERENCE_CHECKSUMS' {
        cpus = 1
        memory = '1 GB'
        disk = '1 GB'
        time = '1h'
        publishDir = [
            path: { "${params.results}/references/${tool}/${reference.id}" },
            mode: params.publish_dir_mode,
            pattern: 'source.sha256',
        ]
    }

    withName: 'BUILD_DEACON_INDEX' {
        cpus = 4
        memory = '6 GB'
        disk = '50 GB'
        time = '8h'
    }

    withName: 'BUILD_SYLPH_DATABASE' {
        cpus = 6
        memory = '8 GB'
        disk = '50 GB'
        time = '12h'
    }

    withName: 'BUILD_SKOPE_QUERY_INDEX' {
        cpus = 6
        memory = '8 GB'
        disk = '50 GB'
        time = '12h'
    }

    withName: 'ENCODE_READS_WITH_BQTOOLS' {
        cpus = 4
        memory = '4 GB'
        disk = '50 GB'
        time = '8h'
    }

    withName: 'FILTER_READS_WITH_DEACON' {
        cpus = 4
        memory = '6 GB'
        disk = '50 GB'
        time = '8h'
        publishDir = [
            [
                path: { "${params.results}/deacon/summaries/${reference.id}" },
                mode: params.publish_dir_mode,
                pattern: '*.summary.json',
            ],
            [
                path: { "${params.results}/deacon/reads/${reference.id}" },
                mode: params.publish_dir_mode,
                pattern: '*.fastq.gz',
            ],
        ]
    }

    withName: 'SKETCH_READS_WITH_SYLPH' {
        cpus = 4
        memory = '4 GB'
        disk = '20 GB'
        time = '8h'
    }

    withName: 'PROFILE_READS_WITH_SYLPH' {
        cpus = 4
        memory = '6 GB'
        disk = '20 GB'
        time = '8h'
        publishDir = [
            path: { "${params.results}/sylph/profiles/${reference.id}" },
            mode: params.publish_dir_mode,
            saveAs: { name -> name == 'versions.yml' ? null : name },
        ]
    }

    withName: 'SUMMARIZE_SYLPH_TAXONOMY' {
        cpus = 1
        memory = '4 GB'
        disk = '10 GB'
        time = '4h'
        publishDir = [
            path: { "${params.results}/sylph/taxonomy/${reference.id}" },
            mode: params.publish_dir_mode,
            saveAs: { name -> name == 'versions.yml' ? null : name },
        ]
    }

    withName: 'QUERY_READS_WITH_SKOPE' {
        cpus = 4
        memory = '6 GB'
        disk = '20 GB'
        time = '8h'
        publishDir = [
            path: { "${params.results}/skope/${reference.id}" },
            mode: params.publish_dir_mode,
            saveAs: { name -> name == 'versions.yml' ? null : name },
        ]
    }
}
