nextflow_process {
    name "Sketch reads with Sylph process"
    script "../modules/local/sketch_reads_with_sylph/main.nf"
    process "SKETCH_READS_WITH_SYLPH"
    tag "modules"
    tag "modules_local"

    test("keeps one sample sketch distinguishable") {
        when {
            process {
                """input[0] = [[kmer_length: 31, compression: 2, no_dedup: true], [id: 'sample-a', platform: 'ont', read_set: 'input'], [file("\$baseDir/tests/data/sylph/reads.fastq")]]"""
            }
        }

        then {
            def output = process.out.sketches[0]
            assertAll(
                { assert process.success },
                { assert output[0] == [kmer_length: 31, compression: 2, no_dedup: true] },
                { assert output[1] == [id: 'sample-a', platform: 'ont', read_set: 'input'] },
                { assert file(output[2]).name == 'sample-a__input.sylsp' },
                { assert file(output[2]).size() > 0 },
            )
        }
    }

    test("streams several FASTQs into one distinguishable sample sketch") {
        setup {
            def shortReads = file("$outputDir/first/reads.fastq.gz")
            def meaningfulReads = file("$outputDir/second/reads.fastq.gz")
            shortReads.parentFile.mkdirs()
            meaningfulReads.parentFile.mkdirs()
            new java.util.zip.GZIPOutputStream(shortReads.newOutputStream()).withCloseable { gzip ->
                gzip.write('@short\nACGT\n+\nIIII\n'.bytes)
            }
            new java.util.zip.GZIPOutputStream(meaningfulReads.newOutputStream()).withCloseable { gzip ->
                gzip.write(file("${projectDir}/tests/data/sylph/reads.fastq").bytes)
            }
        }

        when {
            process {
                """input[0] = [[kmer_length: 31, compression: 2, no_dedup: false], [id: 'sample-a', platform: 'illumina', read_set: 'input'], [file("$outputDir/first/reads.fastq.gz"), file("$outputDir/second/reads.fastq.gz")]]"""
            }
        }

        then {
            def sketch = file(process.out.sketches[0][2])
            assertAll(
                { assert process.success },
                { assert sketch.name == 'sample-a__input.sylsp' },
                { assert sketch.size() > 0 },
            )
        }
    }
}
