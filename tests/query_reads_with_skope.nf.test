nextflow_process {
    name "Query reads with Skope process"
    script "../modules/local/query_reads_with_skope/main.nf"
    process "QUERY_READS_WITH_SKOPE"
    tag "modules"
    tag "modules_local"

    test("queries one input read set with confidence output") {
        setup {
            run("BUILD_SKOPE_QUERY_INDEX") {
                script "../modules/local/build_skope_query_index/main.nf"
                process {
                    """input[0] = [[tool: [name: 'skope', version: 'c016a1fd2441ee16227f9031d636333be35bae74'], sources: [[observed_sha256: 'fixture', logical_basename: 'reference.fa']], settings: [kmer_length: 31, smer_length: 9, fraction: 1.0, individual: false, all_kmers: false, positions: true]], file("\$baseDir/tests/data/sylph/reference.fa")]"""
                }
            }
        }

        when {
            process {
                """
                input[0] = BUILD_SKOPE_QUERY_INDEX.out.query_indexes.map { build, queryIndex ->
                    tuple(
                        [id: 'sample-a', platform: 'ont', read_set: 'input'],
                        [id: 'reference-a', query: [fraction: 1.0, abundance_thresholds: [1, 10], discriminatory: false, confidence: true, limit: null]],
                        [file("\$baseDir/tests/data/sylph/reads.fastq")],
                        queryIndex,
                    )
                }
                """
            }
        }

        then {
            def output = process.out.results[0]
            def lines = file(output[2]).readLines()
            assertAll(
                { assert process.success },
                { assert output[0] == [id: 'sample-a', platform: 'ont', read_set: 'input'] },
                { assert output[1].id == 'reference-a' },
                { assert file(output[2]).name == 'sample-a__input.skope.tsv' },
                { assert lines[0].contains('containment1_ci') },
                { assert lines[1].startsWith('synthetic-reference\tsample-a__input\t') },
                { assert lines.size() == 2 },
                { assert lines.every { line -> !line.startsWith('TOTAL\t') } },
            )
        }
    }

    test("retains merged k-mer records when built with all_kmers") {
        setup {
            def source = 'GATTACAGGCATCCTAGCTAGGACTTGCAACATGCTTAGCCATGGAACTGTCCAGTTACGGATCCTAGGCATTAGCCAGTTCATGGACTTAGCGGATCCTA'
            def targets = file("$outputDir/merged-kmers.fa")
            def reads = file("$outputDir/known-kmers.fastq")
            targets.text = (0..<40).collect { offset ->
                ">kmer-${offset}\n${source.substring(offset, offset + 31)}"
            }.join('\n') + '\n'
            reads.text = "@known-read\n${source.substring(0, 50)}\n+\n${'I' * 50}\n"

            run("BUILD_SKOPE_QUERY_INDEX") {
                script "../modules/local/build_skope_query_index/main.nf"
                process {
                    """
                    input[0] = Channel.of(true, false).map { allKmers ->
                        tuple(
                            [tool: [name: 'skope', version: 'c016a1fd2441ee16227f9031d636333be35bae74'], sources: [[observed_sha256: 'fixture', logical_basename: 'merged-kmers.fa']], settings: [kmer_length: 31, smer_length: 9, fraction: 1.0, individual: false, all_kmers: allKmers, positions: false]],
                            file("$outputDir/merged-kmers.fa"),
                        )
                    }
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = BUILD_SKOPE_QUERY_INDEX.out.query_indexes
                    .map { build, queryIndex ->
                        tuple(
                            [id: 'known-kmers', platform: 'illumina', read_set: 'input'],
                            [id: build.settings.all_kmers ? 'all-kmers' : 'syncmers', query: [fraction: 1.0, abundance_thresholds: [1], discriminatory: false, confidence: false, limit: null]],
                            [file("$outputDir/known-kmers.fastq")],
                            queryIndex,
                        )
                    }
                """
            }
        }

        then {
            def results = process.out.results.collectEntries { meta, reference, result ->
                [(reference.id): file(result)]
            }
            def parseSingleRow = { result ->
                def lines = result.readLines()
                assert lines.size() == 2
                def headers = lines[0].split('\t').toList()
                def values = lines[1].split('\t').toList()
                assert headers.size() == values.size()
                [headers, values].transpose().collectEntries { header, value -> [(header): value] }
            }
            def allKmers = parseSingleRow(results['all-kmers'])
            def syncmers = parseSingleRow(results.syncmers)
            assertAll(
                { assert process.success },
                { assert results.keySet() == ['all-kmers', 'syncmers'] as Set },
                { assert allKmers.target == 'merged-kmers' },
                { assert allKmers.sample == 'known-kmers__input' },
                { assert allKmers.target_kmers.toInteger() == 40 },
                { assert allKmers.containment1.toDouble() == 0.5d },
                { assert allKmers.sample_seqs.toInteger() == 1 },
                { assert allKmers.sample_bases.toInteger() == 50 },
                { assert syncmers.target_kmers.toInteger() * 5 < allKmers.target_kmers.toInteger() },
            )
        }
    }

    test("queries separate targets from a directory of equal-length k-mer FASTAs") {
        setup {
            def matchedSource = 'GATTACAGGCATCCTAGCTAGGACTTGCAACATGCTTAGCCATGGAACTGTCCAGTTACGGATCCTAGGCATTAGCCAGTTCATGGACTTAGCGGATCCTA'
            def unmatchedSource = 'TCGAGCTTACCGATGGCATGATCCGTAACCGGTTAGCGATCCGATGCTTAGGACCTTACGGTACCGATGGCATCGTACCGTTAGGCTAACCGATG'
            def matched = file("$outputDir/matched-target.fa")
            def unmatched = file("$outputDir/unmatched-target.fa")
            def reads = file("$outputDir/known-kmers.fastq")
            matched.text = (0..<40).collect { offset -> ">matched-${offset}\n${matchedSource.substring(offset, offset + 31)}" }.join('\n') + '\n'
            unmatched.text = (0..<40).collect { offset -> ">unmatched-${offset}\n${unmatchedSource.substring(offset, offset + 31)}" }.join('\n') + '\n'
            reads.text = "@known-read\n${matchedSource.substring(0, 50)}\n+\n${'I' * 50}\n"

            run("BUILD_SKOPE_QUERY_INDEX") {
                script "../modules/local/build_skope_query_index/main.nf"
                process {
                    """input[0] = [[tool: [name: 'skope', version: 'c016a1fd2441ee16227f9031d636333be35bae74'], sources: [[observed_sha256: 'matched', logical_basename: 'matched-target.fa'], [observed_sha256: 'unmatched', logical_basename: 'unmatched-target.fa']], settings: [kmer_length: 31, smer_length: 9, fraction: 1.0, individual: false, all_kmers: true, positions: false]], [file("$outputDir/matched-target.fa"), file("$outputDir/unmatched-target.fa")]]"""
                }
            }
        }

        when {
            process {
                """
                input[0] = BUILD_SKOPE_QUERY_INDEX.out.query_indexes.map { build, queryIndex ->
                    tuple(
                        [id: 'known-kmers', platform: 'illumina', read_set: 'input'],
                        [id: 'separate-targets', query: [fraction: 1.0, abundance_thresholds: [1, 2], discriminatory: false, confidence: false, limit: null]],
                        [file("$outputDir/known-kmers.fastq")],
                        queryIndex,
                    )
                }
                """
            }
        }

        then {
            def rows = file(process.out.results[0][2]).readLines()
            def headers = rows[0].split('\t').toList()
            def targets = rows.drop(1).collectEntries { line ->
                def values = line.split('\t').toList()
                [(values[headers.indexOf('target')]): [headers, values].transpose().collectEntries { header, value -> [(header): value] }]
            }
            assertAll(
                { assert process.success },
                { assert rows.size() == 3 },
                { assert targets.keySet() == ['matched-target', 'unmatched-target'] as Set },
                { assert targets.values().every { row -> row.target_kmers.toInteger() == 40 } },
                { assert targets['matched-target'].containment1.toDouble() == 0.5d },
                { assert targets['matched-target'].containment2.toDouble() == 0.0d },
                { assert targets['unmatched-target'].containment1.toDouble() == 0.0d },
                { assert targets['unmatched-target'].containment2.toDouble() == 0.0d },
            )
        }
    }

    test("queries several gzip-compressed FASTQs as one sample") {
        setup {
            def readOne = file("$outputDir/r1/reads.fastq.gz")
            def readTwo = file("$outputDir/r2/reads.fastq.gz")
            def readThree = file("$outputDir/extra/reads.fastq.gz")
            readOne.parentFile.mkdirs()
            readTwo.parentFile.mkdirs()
            readThree.parentFile.mkdirs()
            new java.util.zip.GZIPOutputStream(readOne.newOutputStream()).withCloseable { gzip ->
                gzip.write(file("${projectDir}/tests/data/deacon/mates/r1/reads.fastq").bytes)
            }
            new java.util.zip.GZIPOutputStream(readTwo.newOutputStream()).withCloseable { gzip ->
                gzip.write(file("${projectDir}/tests/data/deacon/mates/r2/reads.fastq").bytes)
            }
            new java.util.zip.GZIPOutputStream(readThree.newOutputStream()).withCloseable { gzip ->
                gzip.write(file("${projectDir}/tests/data/fastq/single.fastq").bytes)
            }

            run("BUILD_SKOPE_QUERY_INDEX") {
                script "../modules/local/build_skope_query_index/main.nf"
                process {
                    """input[0] = [[tool: [name: 'skope', version: 'c016a1fd2441ee16227f9031d636333be35bae74'], sources: [[observed_sha256: 'fixture', logical_basename: 'reference.fa']], settings: [kmer_length: 31, smer_length: 9, fraction: 1.0, individual: false, all_kmers: false, positions: false]], file("\$baseDir/tests/data/sylph/reference.fa")]"""
                }
            }
        }

        when {
            process {
                """
                input[0] = BUILD_SKOPE_QUERY_INDEX.out.query_indexes.map { build, queryIndex ->
                    tuple(
                        [id: 'sample-a', platform: 'illumina', read_set: 'deacon_filtered', deacon_id: 'host'],
                        [id: 'reference-a', query: [fraction: 1.0, abundance_thresholds: [10], discriminatory: false, confidence: false, limit: null]],
                        [file("$outputDir/r1/reads.fastq.gz"), file("$outputDir/r2/reads.fastq.gz"), file("$outputDir/extra/reads.fastq.gz")],
                        queryIndex,
                    )
                }
                """
            }
        }

        then {
            def output = process.out.results[0]
            def rows = file(output[2]).readLines().collect { line -> line.split('\t').toList() }
            def sampleColumn = rows[0].indexOf('sample')
            def sampleSeqsColumn = rows[0].indexOf('sample_seqs')
            assertAll(
                { assert process.success },
                { assert file(output[2]).name == 'sample-a__deacon-host.skope.tsv' },
                { assert rows[1][sampleColumn] == 'sample-a__deacon-host' },
                { assert rows[1][sampleSeqsColumn] == '3' },
                { assert rows.size() == 2 },
                { assert rows.every { row -> row[0] != 'TOTAL' } },
            )
        }
    }

    test("stubs a distinguishable Skope result") {
        when {
            process {
                """input[0] = [[id: 'sample-a', platform: 'ont', read_set: 'input'], [id: 'reference-a', query: [fraction: 1.0, abundance_thresholds: [10], discriminatory: false, confidence: false, limit: null]], [file("\$baseDir/tests/data/sylph/reads.fastq")], file("\$baseDir/tests/data/sylph/prebuilt.syldb")]"""
            }
            options '-stub-run'
        }

        then {
            def output = process.out.results[0]
            assertAll(
                { assert process.success },
                { assert output[0].read_set == 'input' },
                { assert output[1].id == 'reference-a' },
                { assert file(output[2]).name == 'sample-a__input.skope.tsv' },
                { assert file(output[2]).readLines()[1].startsWith('stub-target\tsample-a__input\t') },
                { assert file(output[2]).readLines().every { line -> !line.startsWith('TOTAL\t') } },
            )
        }
    }
}
