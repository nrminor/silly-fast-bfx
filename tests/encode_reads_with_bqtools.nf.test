nextflow_process {
    name "Encode reads with bqtools process"
    script "../modules/local/encode_reads_with_bqtools/main.nf"
    process "ENCODE_READS_WITH_BQTOOLS"
    tag "modules"
    tag "modules_local"

    test("encodes one FASTQ as CBQ") {
        when {
            process {
                """input[0] = [[id: 'single', platform: 'ont', read_set: 'input'], [file("\$baseDir/tests/data/deacon/matching.fastq")]]"""
            }
        }

        then {
            def output = process.out.encodings[0]
            assertAll(
                { assert process.success },
                { assert output[0].id == 'single' },
                { assert file(output[1]).name == 'single.cbq' },
                { assert file(output[1]).size() > 0 },
            )
        }
    }

    test("encodes two FASTQs as independent records in one CBQ") {
        setup {
            [
                [file("$outputDir/r1/reads.fastq.gz"), file("${projectDir}/tests/data/fastq/paired_R1.fastq")],
                [file("$outputDir/r2/reads.fastq.gz"), file("${projectDir}/tests/data/fastq/paired_R2.fastq")],
            ].each { target, source ->
                target.parentFile.mkdirs()
                new java.util.zip.GZIPOutputStream(target.newOutputStream()).withCloseable { gzip ->
                    gzip.write(source.bytes)
                }
            }
        }

        when {
            process {
                """input[0] = [[id: 'sample-a', platform: 'illumina', read_set: 'input'], [file("$outputDir/r1/reads.fastq.gz"), file("$outputDir/r2/reads.fastq.gz")]]"""
            }
        }

        then {
            def output = process.out.encodings[0]
            def info = ['bqtools', 'info', '--num', file(output[1]).toString()].execute()
            def record_count = info.text.trim().split('\\t')[0]
            assert process.success
            assert process.out.encodings.size() == 1
            assert info.waitFor() == 0
            assert record_count == '4'
        }
    }

    test("stubs several reads without changing metadata") {
        when {
            process {
                """input[0] = [[id: 'paired', platform: 'illumina', read_set: 'input'], [file("\$baseDir/tests/data/fastq/paired_R1.fastq"), file("\$baseDir/tests/data/fastq/paired_R2.fastq")]]"""
            }
            options '-stub-run'
        }

        then {
            def output = process.out.encodings[0]
            assertAll(
                { assert process.success },
                { assert output[0] == [id: 'paired', platform: 'illumina', read_set: 'input'] },
                { assert file(output[1]).name == 'paired.cbq' },
                { assert file(output[1]).text == 'stub cbq' },
            )
        }
    }

}
