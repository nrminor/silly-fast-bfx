nextflow_process {
    name "Map reads with minimap2"
    script "../modules/local/map_reads_with_minimap2/main.nf"
    process "MAP_READS_WITH_MINIMAP2"
    tag "modules"
    tag "modules_local"

    test("maps indexed same-basename lanes with secondary placements and distinct counts") {
        setup {
            run("PREPARE_MAPPING_IDENTITIES") {
                script "../modules/local/prepare_mapping_identities/main.nf"
                process {
                    """input[0] = [[id: 'sample-a', platform: 'illumina', read_set: 'input'], [file("\$baseDir/tests/data/mapping/lanes/r1/reads.fastq"), file("\$baseDir/tests/data/mapping/lanes/r2/reads.fastq")]]"""
                }
            }
        }

        when {
            process {
                """
                input[0] = PREPARE_MAPPING_IDENTITIES.out.identities.map { meta, reads, collisions, readCount, hasReads ->
                    tuple(
                        meta,
                        [id: 'mapping-a', align: [ont: [preset: 'map-ont', max_secondary: 5, secondary_score_ratio: 0.8], illumina: [preset: 'sr', max_secondary: 20, secondary_score_ratio: 0.5]]],
                        file("\$baseDir/tests/data/mapping/ambiguous-reference.fa"),
                        reads,
                        collisions,
                        readCount,
                    )
                }
                """
            }
        }

        then {
            def output = process.out.alignments[0]
            def records = ['samtools', 'view', file(output[2]).toString()].execute().text.readLines()
            def flags = records.collect { line -> line.split('\t')[1].toInteger() }
            assertAll(
                { assert process.success },
                { assert file(output[3]).exists() },
                { assert file(output[4]).text == '{"total_reads": 2, "mapped_reads": 2, "unmapped_reads": 0}\n' },
                { assert records.size() >= 4 },
                { assert records.collect { line -> line.split('\t')[0] } as Set == ['same/1', 'same/2'] as Set },
                { assert flags.any { flag -> (flag & 256) != 0 } },
            )
        }
    }
}
