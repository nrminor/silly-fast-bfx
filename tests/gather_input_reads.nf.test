nextflow_workflow {
    name "Gather exact local input reads"
    script "../subworkflows/local/gather_input_reads/main.nf"
    workflow "GATHER_INPUT_READS"
    tag "subworkflows"
    tag "subworkflows_local"
    tag "gather_input_reads"

    test("emits exact FASTQs in samplesheet order") {
        setup {
            def samplesheet = file("$outputDir/exact.csv")
            samplesheet.parentFile.mkdirs()
            [
                'paired_R1.fastq.gz': file("${projectDir}/tests/data/fastq/paired_R1.fastq"),
                'paired_R2.fastq.gz': file("${projectDir}/tests/data/fastq/paired_R2.fastq"),
                'single.fastq.gz': file("${projectDir}/tests/data/fastq/single.fastq"),
            ].each { name, source ->
                new java.util.zip.GZIPOutputStream(file("$outputDir/$name").newOutputStream()).withCloseable { gzip ->
                    gzip.write(source.bytes)
                }
            }
            samplesheet.text = [
                "sample_id,srr,platform,fastq1,fastq2,fastq1_glob,fastq2_glob",
                "paired,SRR123456,illumina,$outputDir/paired_R1.fastq.gz,$outputDir/paired_R2.fastq.gz,$outputDir/paired_R1*.fastq.gz,$outputDir/paired_R2*.fastq.gz",
                "single,,Oxford_Nanopore,$outputDir/single.fastq.gz,,,",
            ].join('\n') + '\n'
        }

        when {
            workflow {
                """
                input[0] = "$outputDir/exact.csv"
                """
            }
        }

        then {
            def reads_by_id = workflow.out.reads.collectEntries { meta, reads ->
                [(meta.id): [meta: meta, reads: reads.collect { file(it).name }]]
            }
            def preserved = file(workflow.out.samplesheet[0])

            assertAll(
                { assert workflow.success },
                { assert !workflow.trace.tasks().any { it.name.contains('VALIDATE_SRACHA_RUN') } },
                { assert !workflow.trace.tasks().any { it.name.contains('DOWNLOAD_SRACHA_FASTQ') } },
                { assert preserved.name == "samplesheet.csv" },
                { assert preserved.text == file("$outputDir/exact.csv").text },
                { assert reads_by_id.keySet() == ["paired", "single"] as Set },
                { assert reads_by_id.paired.meta == [id: "paired", platform: "illumina", read_set: "input"] },
                { assert reads_by_id.paired.reads == ["paired_R1.fastq.gz", "paired_R2.fastq.gz"] },
                { assert reads_by_id.single.meta == [id: "single", platform: "ont", read_set: "input"] },
                { assert reads_by_id.single.reads == ["single.fastq.gz"] },
            )
        }
    }

    test("emits every grouped FASTQ in deterministic order") {
        setup {
            def samplesheet = file("$outputDir/grouped.csv")
            samplesheet.parentFile.mkdirs()
            [
                'grouped_L002_R1_001.fastq.gz': '@r1-l2',
                'grouped_L001_R1_001.fastq.gz': '@r1-l1',
                'grouped_L002_R2_001.fastq.gz': '@r2-l2',
                'grouped_L001_R2_001.fastq.gz': '@r2-l1',
            ].each { name, header ->
                new java.util.zip.GZIPOutputStream(file("$outputDir/$name").newOutputStream()).withCloseable { gzip ->
                    gzip.write("$header\nAC\n+\nII\n".bytes)
                }
            }
            samplesheet.text = [
                "sample_id,srr,platform,fastq1,fastq2,fastq1_glob,fastq2_glob",
                "grouped,SRR000002,illumina,,,$outputDir/grouped_L*_R1_001.fastq.gz,$outputDir/grouped_L*_R2_001.fastq.gz",
            ].join('\n') + '\n'
        }

        when {
            workflow {
                """
                input[0] = "$outputDir/grouped.csv"
                """
            }
        }

        then {
            def output = workflow.out.reads[0]
            def reads = output[1].collect { read -> file(read).name }
            assertAll(
                { assert workflow.success },
                { assert !workflow.trace.tasks().any { it.name.contains('VALIDATE_SRACHA_RUN') } },
                { assert !workflow.trace.tasks().any { it.name.contains('DOWNLOAD_SRACHA_FASTQ') } },
                { assert !workflow.stderr.join('\n').contains('use `files()` instead') },
                { assert output[0] == [id: 'grouped', platform: 'illumina', read_set: 'input'] },
                { assert reads == [
                    'grouped_L001_R1_001.fastq.gz',
                    'grouped_L002_R1_001.fastq.gz',
                    'grouped_L001_R2_001.fastq.gz',
                    'grouped_L002_R2_001.fastq.gz',
                ] },
            )
        }
    }

    test("rejects an uncompressed local FASTQ") {
        setup {
            def samplesheet = file("$outputDir/uncompressed.csv")
            samplesheet.parentFile.mkdirs()
            samplesheet.text = [
                "sample_id,srr,platform,fastq1,fastq2",
                "sample-a,,ont,${projectDir}/tests/data/fastq/single.fastq,",
            ].join('\n') + '\n'
        }

        when {
            workflow {
                """
                input[0] = "$outputDir/uncompressed.csv"
                """
            }
        }

        then {
            assert workflow.failed
            assert workflow.stderr.join('\n').contains("gzip-compressed FASTQ")
        }
    }

    test("emits every downloaded SRA FASTQ") {
        setup {
            def samplesheet = file("$outputDir/sra.csv")
            samplesheet.parentFile.mkdirs()
            samplesheet.text = [
                "sample_id,srr,platform,fastq1,fastq2",
                "single-sra,srr000001,Oxford_Nanopore,,",
                "paired-sra,SRR000002,illumina,,",
            ].join('\n') + '\n'
        }

        when {
            workflow {
                """
                input[0] = "$outputDir/sra.csv"
                """
            }
        }

        then {
            def reads_by_id = workflow.out.reads.collectEntries { meta, reads ->
                [(meta.id): [meta: meta, reads: reads.collect { file(it).name }]]
            }
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().count { it.name.contains('VALIDATE_SRACHA_RUN') } == 2 },
                { assert workflow.trace.tasks().count { it.name.contains('DOWNLOAD_SRACHA_FASTQ') } == 2 },
                { assert reads_by_id.keySet() == ['single-sra', 'paired-sra'] as Set },
                { assert reads_by_id['single-sra'].meta == [id: 'single-sra', platform: 'ont', read_set: 'input'] },
                { assert reads_by_id['single-sra'].reads == ['SRR000001.fastq.gz'] },
                { assert reads_by_id['paired-sra'].meta == [id: 'paired-sra', platform: 'illumina', read_set: 'input'] },
                { assert reads_by_id['paired-sra'].reads == ['SRR000002_1.fastq.gz', 'SRR000002_2.fastq.gz'] },
            )
        }
    }

    test("rejects duplicate sample IDs") {
        setup {
            def samplesheet = file("$outputDir/duplicate.csv")
            samplesheet.parentFile.mkdirs()
            samplesheet.text = [
                "sample_id,srr,platform,fastq1,fastq2",
                "duplicate,SRR123456,illumina,,",
                "duplicate,SRR123457,ont,,",
            ].join('\n') + '\n'
        }

        when {
            workflow {
                """
                input[0] = "$outputDir/duplicate.csv"
                """
            }
        }

        then {
            assert workflow.failed
            assert workflow.stderr.join('\n').contains("Detected duplicate entries: [sample_id:duplicate]")
        }
    }

    test("rejects populated unknown columns") {
        setup {
            def samplesheet = file("$outputDir/unknown-column.csv")
            samplesheet.parentFile.mkdirs()
            samplesheet.text = [
                "sample_id,srr,platform,fastq1,fastq2,fastq_2",
                "sample-a,SRR123456,illumina,,,${projectDir}/tests/data/fastq/paired_R2.fastq",
            ].join('\n') + '\n'
        }

        when {
            workflow {
                """
                input[0] = "$outputDir/unknown-column.csv"
                """
            }
        }

        then {
            assert workflow.failed
            assert workflow.stderr.join('\n').contains("fastq_2")
        }
    }

    test("rejects mate 2 without mate 1") {
        setup {
            def samplesheet = file("$outputDir/mate-2-only.csv")
            samplesheet.parentFile.mkdirs()
            def mateTwo = file("$outputDir/paired_R2.fastq.gz")
            new java.util.zip.GZIPOutputStream(mateTwo.newOutputStream()).withCloseable { gzip ->
                gzip.write(file("${projectDir}/tests/data/fastq/paired_R2.fastq").bytes)
            }
            samplesheet.text = [
                "sample_id,srr,platform,fastq1,fastq2",
                "sample-a,,illumina,,$mateTwo",
            ].join('\n') + '\n'
        }

        when {
            workflow {
                """
                input[0] = "$outputDir/mate-2-only.csv"
                """
            }
        }

        then {
            assert workflow.failed
            assert workflow.stderr.join('\n').contains("mate 2 cannot appear without mate 1")
        }
    }

    test("does not treat an exact-path glob as a lower-priority source") {
        setup {
            def samplesheet = file("$outputDir/exact-glob.csv")
            samplesheet.parentFile.mkdirs()
            samplesheet.text = [
                "sample_id,srr,platform,fastq1,fastq2",
                "sample-a,SRR123456,illumina,${projectDir}/tests/data/fastq/literal[reads].fastq.gz,",
            ].join('\n') + '\n'
        }

        when {
            workflow {
                """
                input[0] = "$outputDir/exact-glob.csv"
                """
            }
        }

        then {
            assert workflow.failed
            assert workflow.stderr.join('\n').contains("fastq1")
            assert !workflow.stdout.join('\n').contains("SRA input is available in a later review unit")
        }
    }

    test("rejects publication-unsafe sample IDs") {
        setup {
            def samplesheet = file("$outputDir/unsafe-id.csv")
            samplesheet.parentFile.mkdirs()
            samplesheet.text = [
                "sample_id,srr,platform,fastq1,fastq2",
                "sample/a,SRR123456,illumina,,",
            ].join('\n') + '\n'
        }

        when {
            workflow {
                """
                input[0] = "$outputDir/unsafe-id.csv"
                """
            }
        }

        then {
            assert workflow.failed
            assert workflow.stderr.join('\n').contains("sample_id")
        }
    }
}
