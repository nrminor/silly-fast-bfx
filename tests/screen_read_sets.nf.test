nextflow_workflow {
    name "Screen read sets"
    script "../subworkflows/local/screen_read_sets/main.nf"
    workflow "SCREEN_READ_SETS"
    tag "subworkflows"
    tag "subworkflows_local"

    test("encodes each read set once and performs the full Deacon Cartesian product") {
        when {
            workflow {
                """
                input[0] = channel.of(
                    tuple(
                        [id: 'sample-a', platform: 'ont', single_end: true, read_set: 'input'],
                        [file("\$baseDir/tests/data/deacon/matching.fastq")],
                    ),
                    tuple(
                        [id: 'sample-b', platform: 'ont', single_end: true, read_set: 'input'],
                        [file("\$baseDir/tests/data/deacon/nonmatching.fastq")],
                    ),
                )
                input[1] = channel.of(
                    tuple(
                        [id: 'meaningful', filter: [abs_threshold: 1, rel_threshold: 0.0, prefix_length: 0, complexity_threshold: null, deplete: false]],
                        file("\$baseDir/tests/data/deacon/reference.k31w15.idx"),
                    ),
                    tuple(
                        [id: 'empty', filter: [abs_threshold: 100, rel_threshold: 0.0, prefix_length: 0, complexity_threshold: null, deplete: false]],
                        file("\$baseDir/tests/data/deacon/reference.k31w15.idx"),
                    ),
                )
                input[2] = channel.empty()
                input[3] = channel.empty()
                input[4] = channel.empty()
                """
            }
        }

        then {
            def official = workflow.out.deacon.collectEntries { meta, reference, reads, summary, has_reads ->
                [("${meta.id}:${reference.id}".toString()): [meta: meta, reads: reads, summary: summary, has_reads: has_reads]]
            }
            def filtered = workflow.out.filtered_reads[0]
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().count { it.name.contains('ENCODE_READS_WITH_BQTOOLS') } == 2 },
                { assert workflow.trace.tasks().count { it.name.contains('FILTER_READS_WITH_DEACON') } == 4 },
                { assert official.keySet() == ['sample-a:meaningful', 'sample-a:empty', 'sample-b:meaningful', 'sample-b:empty'] as Set },
                { assert official['sample-a:meaningful'].has_reads == 'true' },
                { assert official.findAll { key, output -> key != 'sample-a:meaningful' }.values().every { output -> output.has_reads == 'false' } },
                { assert official.values().every { output -> output.meta.read_set == 'input' && !output.meta.containsKey('deacon_id') } },
                { assert workflow.out.filtered_reads.size() == 1 },
                { assert filtered[0] == [id: 'sample-a', platform: 'ont', single_end: true, read_set: 'deacon_filtered', deacon_id: 'meaningful'] },
                { assert filtered[1].collect { file(it).name } == ['sample-a.fastq.gz'] },
            )
        }
    }

    test("preserves paired mates with colliding source basenames") {
        when {
            workflow {
                """
                input[0] = channel.of(tuple(
                    [id: 'paired', platform: 'illumina', single_end: false, read_set: 'input'],
                    [
                        file("\$baseDir/tests/data/deacon/mates/r1/reads.fastq"),
                        file("\$baseDir/tests/data/deacon/mates/r2/reads.fastq"),
                    ],
                ))
                input[1] = channel.of(tuple(
                    [id: 'reference-a', filter: [abs_threshold: 1, rel_threshold: 0.0, prefix_length: 0, complexity_threshold: null, deplete: false]],
                    file("\$baseDir/tests/data/deacon/reference.k31w15.idx"),
                ))
                input[2] = channel.empty()
                input[3] = channel.empty()
                input[4] = channel.empty()
                """
            }
        }

        then {
            def output = workflow.out.filtered_reads[0]
            def reads = output[1].collect { path ->
                new java.util.zip.GZIPInputStream(file(path).newInputStream()).text
            }
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().count { it.name.contains('ENCODE_READS_WITH_BQTOOLS') } == 1 },
                { assert workflow.trace.tasks().count { it.name.contains('FILTER_READS_WITH_DEACON') } == 1 },
                { assert reads[0] == file("${projectDir}/tests/data/deacon/mates/r1/reads.fastq").text },
                { assert reads[1] == file("${projectDir}/tests/data/deacon/mates/r2/reads.fastq").text },
            )
        }
    }

    test("does not encode when there are no Deacon references") {
        when {
            workflow {
                """
                input[0] = channel.of(tuple(
                    [id: 'sample-a', platform: 'ont', single_end: true, read_set: 'input'],
                    [file("\$baseDir/tests/data/deacon/matching.fastq")],
                ))
                input[1] = channel.empty()
                input[2] = channel.empty()
                input[3] = channel.empty()
                input[4] = channel.empty()
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().isEmpty() },
                { assert workflow.out.deacon.isEmpty() },
                { assert workflow.out.filtered_reads.isEmpty() },
            )
        }
    }

    test("keeps sample sketches separate while reusing each compatible sketch across Sylph references") {
        setup {
            run("BUILD_DEACON_INDEX") {
                script "../modules/local/build_deacon_index/main.nf"
                process {
                    """input[0] = [[observed_sha256: 'fixture', settings: [kmer_length: 31, window_size: 15]], file("\$baseDir/tests/data/sylph/reference.fa")]"""
                }
            }
            run("BUILD_SYLPH_DATABASE") {
                script "../modules/local/build_sylph_database/main.nf"
                process {
                    """input[0] = [[sources: [[observed_sha256: 'fixture', logical_basename: 'reference.fa']], settings: [kmer_length: 31, compression: 2, individual_records: false, min_spacing: 2]], [file("\$baseDir/tests/data/sylph/reference.fa")]]"""
                }
            }
        }

        when {
            workflow {
                """
                input[0] = channel.of(
                    tuple(
                        [id: 'sample-a', platform: 'ont', single_end: true, read_set: 'input'],
                        [file("\$baseDir/tests/data/sylph/reads.fastq")],
                    ),
                    tuple(
                        [id: 'sample-b', platform: 'ont', single_end: true, read_set: 'input'],
                        [file("\$baseDir/tests/data/sylph/reads.fastq")],
                    ),
                )
                input[1] = BUILD_DEACON_INDEX.out.indexes.map { build, index ->
                    tuple(
                        [id: 'deacon-a', filter: [abs_threshold: 1, rel_threshold: 0.0, prefix_length: 0, complexity_threshold: null, deplete: false]],
                        index,
                    )
                }
                input[2] = BUILD_SYLPH_DATABASE.out.databases.flatMap { build, database ->
                    [
                        tuple([kmer_length: 31, compression: 2], [id: 'sylph-a', sample_sketch: [kmer_length: 31, compression: 2], profile: [minimum_ani: 95, min_count_correct: 1, min_number_kmers: 1, redundant_ani: 99]], database),
                        tuple([kmer_length: 31, compression: 2], [id: 'sylph-b', sample_sketch: [kmer_length: 31, compression: 2], profile: [minimum_ani: 95, min_count_correct: 1, min_number_kmers: 1, redundant_ani: 99]], database),
                        tuple([kmer_length: 31, compression: 1], [id: 'sylph-c', sample_sketch: [kmer_length: 31, compression: 1], profile: [minimum_ani: 95, min_count_correct: 1, min_number_kmers: 1000000000, redundant_ani: 99]], database),
                    ]
                }
                input[3] = channel.empty()
                input[4] = channel.empty()
                """
            }
        }

        then {
            def profiles = workflow.out.sylph.collectEntries { meta, reference, profile, hasRows ->
                def readSet = meta.read_set == 'input' ? 'input' : "deacon:${meta.deacon_id}"
                [("${meta.id}:${readSet}:${reference.id}".toString()): [meta: meta, profile: file(profile), hasRows: hasRows]]
            }
            def meaningfulProfiles = workflow.out.sylph_profiles.collectEntries { meta, reference, profile ->
                def readSet = meta.read_set == 'input' ? 'input' : "deacon:${meta.deacon_id}"
                [("${meta.id}:${readSet}:${reference.id}".toString()): file(profile)]
            }
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().count { it.name.contains('FILTER_READS_WITH_DEACON') } == 2 },
                { assert workflow.trace.tasks().count { it.name.contains('SKETCH_READS_WITH_SYLPH') } == 8 },
                { assert workflow.trace.tasks().count { it.name.contains('PROFILE_READS_WITH_SYLPH') } == 12 },
                {
                    assert profiles.keySet() == [
                        'sample-a:input:sylph-a', 'sample-a:input:sylph-b', 'sample-a:input:sylph-c',
                        'sample-a:deacon:deacon-a:sylph-a', 'sample-a:deacon:deacon-a:sylph-b', 'sample-a:deacon:deacon-a:sylph-c',
                        'sample-b:input:sylph-a', 'sample-b:input:sylph-b', 'sample-b:input:sylph-c',
                        'sample-b:deacon:deacon-a:sylph-a', 'sample-b:deacon:deacon-a:sylph-b', 'sample-b:deacon:deacon-a:sylph-c',
                    ] as Set
                },
                {
                    assert profiles.values()*.profile*.name as Set == [
                        'sample-a__input.profile.tsv',
                        'sample-a__deacon-deacon-a.profile.tsv',
                        'sample-b__input.profile.tsv',
                        'sample-b__deacon-deacon-a.profile.tsv',
                    ] as Set
                },
                { assert profiles.findAll { key, output -> key.endsWith(':sylph-c') }.values().every { output -> output.hasRows == 'false' && output.profile.readLines().size() == 1 } },
                { assert profiles.findAll { key, output -> !key.endsWith(':sylph-c') }.values().every { output -> output.hasRows == 'true' } },
                {
                    assert profiles.findAll { key, output -> !key.endsWith(':sylph-c') }.values().every { output ->
                        def readSetName = output.meta.read_set == 'input'
                            ? 'input'
                            : "deacon-${output.meta.deacon_id}"
                        output.profile.readLines()[1].startsWith("${output.meta.id}__${readSetName}\t")
                    }
                },
                {
                    assert meaningfulProfiles.keySet() == [
                        'sample-a:input:sylph-a', 'sample-a:input:sylph-b',
                        'sample-a:deacon:deacon-a:sylph-a', 'sample-a:deacon:deacon-a:sylph-b',
                        'sample-b:input:sylph-a', 'sample-b:input:sylph-b',
                        'sample-b:deacon:deacon-a:sylph-a', 'sample-b:deacon:deacon-a:sylph-b',
                    ] as Set
                },
            )
        }
    }

    test("withholds meaningful Deacon-filtered read sets from searches when post-Deacon screening is skipped") {
        setup {
            run("BUILD_DEACON_INDEX") {
                script "../modules/local/build_deacon_index/main.nf"
                process {
                    """input[0] = [[observed_sha256: 'fixture', settings: [kmer_length: 31, window_size: 15]], file("\$baseDir/tests/data/sylph/reference.fa")]"""
                }
            }
            run("BUILD_SYLPH_DATABASE") {
                script "../modules/local/build_sylph_database/main.nf"
                process {
                    """input[0] = [[sources: [[observed_sha256: 'fixture', logical_basename: 'reference.fa']], settings: [kmer_length: 31, compression: 2, individual_records: false, min_spacing: 2]], [file("\$baseDir/tests/data/sylph/reference.fa")]]"""
                }
            }
            run("BUILD_SKOPE_QUERY_INDEX") {
                script "../modules/local/build_skope_query_index/main.nf"
                process {
                    """input[0] = [[tool: [name: 'skope', version: '0.4.0'], sources: [[observed_sha256: 'fixture', logical_basename: 'reference.fa']], settings: [kmer_length: 31, smer_length: 9, fraction: 1.0, individual: false, positions: false]], file("\$baseDir/tests/data/sylph/reference.fa")]"""
                }
            }
        }

        when {
            params {
                skip_post_deacon = true
            }
            workflow {
                """
                input[0] = channel.of(tuple(
                    [id: 'sample-a', platform: 'ont', single_end: true, read_set: 'input'],
                    [file("\$baseDir/tests/data/sylph/reads.fastq")],
                ))
                input[1] = BUILD_DEACON_INDEX.out.indexes.map { build, index ->
                    tuple(
                        [id: 'deacon-a', filter: [abs_threshold: 1, rel_threshold: 0.0, prefix_length: 0, complexity_threshold: null, deplete: false]],
                        index,
                    )
                }
                input[2] = BUILD_SYLPH_DATABASE.out.databases.map { build, database ->
                    tuple(
                        [kmer_length: 31, compression: 2],
                        [id: 'sylph-a', sample_sketch: [kmer_length: 31, compression: 2], profile: [minimum_ani: 95, min_count_correct: 1, min_number_kmers: 1, redundant_ani: 99]],
                        database,
                    )
                }
                input[3] = channel.empty()
                input[4] = BUILD_SKOPE_QUERY_INDEX.out.query_indexes.map { build, queryIndex ->
                    tuple(
                        [id: 'skope-a', query: [fraction: 1.0, abundance_thresholds: [10], discriminatory: false, confidence: false, limit: null]],
                        queryIndex,
                    )
                }
                """
            }
        }

        then {
            def output = workflow.out.sylph[0]
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().count { it.name.contains('FILTER_READS_WITH_DEACON') } == 1 },
                { assert workflow.out.filtered_reads.size() == 1 },
                { assert workflow.trace.tasks().count { it.name.contains('SKETCH_READS_WITH_SYLPH') } == 1 },
                { assert workflow.trace.tasks().count { it.name.contains('PROFILE_READS_WITH_SYLPH') } == 1 },
                { assert output[0].read_set == 'input' },
                { assert workflow.trace.tasks().count { it.name.contains('QUERY_READS_WITH_SKOPE') } == 1 },
                { assert workflow.out.skope[0][0].read_set == 'input' },
            )
        }
    }

    test("summarizes only meaningful profiles with configured taxonomy mappings") {
        setup {
            run("BUILD_SYLPH_DATABASE") {
                script "../modules/local/build_sylph_database/main.nf"
                process {
                    """input[0] = [[sources: [[observed_sha256: 'fixture', logical_basename: 'reference.fa']], settings: [kmer_length: 31, compression: 2, individual_records: false, min_spacing: 2]], [file("\$baseDir/tests/data/sylph/reference.fa")]]"""
                }
            }
        }

        when {
            workflow {
                """
                input[0] = channel.of(tuple(
                    [id: 'sample-a', platform: 'ont', single_end: true, read_set: 'input'],
                    [file("\$baseDir/tests/data/sylph/reads.fastq")],
                ))
                input[1] = channel.empty()
                input[2] = BUILD_SYLPH_DATABASE.out.databases.flatMap { build, database ->
                    [
                        tuple([kmer_length: 31, compression: 2], [id: 'configured', sample_sketch: [kmer_length: 31, compression: 2], profile: [minimum_ani: 95, min_count_correct: 1, min_number_kmers: 1, redundant_ani: 99]], database),
                        tuple([kmer_length: 31, compression: 2], [id: 'raw-only', sample_sketch: [kmer_length: 31, compression: 2], profile: [minimum_ani: 95, min_count_correct: 1, min_number_kmers: 1, redundant_ani: 99]], database),
                        tuple([kmer_length: 31, compression: 2], [id: 'empty', sample_sketch: [kmer_length: 31, compression: 2], profile: [minimum_ani: 95, min_count_correct: 1, min_number_kmers: 1000000000, redundant_ani: 99]], database),
                    ]
                }
                input[3] = channel.of(
                    tuple([id: 'configured'], [], [file("\$baseDir/tests/data/sylph/taxonomy-a.tsv")]),
                    tuple([id: 'empty'], [], [file("\$baseDir/tests/data/sylph/taxonomy-a.tsv")]),
                )
                input[4] = channel.empty()
                """
            }
        }

        then {
            def raw = workflow.out.sylph.collectEntries { meta, reference, profile, hasRows ->
                [(reference.id): [profile: file(profile), hasRows: hasRows]]
            }
            def taxonomy = workflow.out.sylph_taxonomy[0]
            assertAll(
                { assert workflow.success },
                { assert raw.keySet() == ['configured', 'raw-only', 'empty'] as Set },
                { assert raw.configured.hasRows == 'true' },
                { assert raw['raw-only'].hasRows == 'true' },
                { assert raw.empty.hasRows == 'false' },
                { assert workflow.trace.tasks().count { it.name.contains('SUMMARIZE_SYLPH_TAXONOMY') } == 1 },
                { assert workflow.out.sylph_taxonomy.size() == 1 },
                { assert taxonomy[1].id == 'configured' },
                { assert file(taxonomy[2]).name == 'sample-a__input.sylphmpa' },
            )
        }
    }

    test("queries every input and meaningful filtered read set against every Skope reference") {
        setup {
            run("BUILD_DEACON_INDEX") {
                script "../modules/local/build_deacon_index/main.nf"
                process {
                    """input[0] = [[observed_sha256: 'fixture', settings: [kmer_length: 31, window_size: 15]], file("\$baseDir/tests/data/sylph/reference.fa")]"""
                }
            }
            run("BUILD_SKOPE_QUERY_INDEX") {
                script "../modules/local/build_skope_query_index/main.nf"
                process {
                    """input[0] = [[tool: [name: 'skope', version: '0.4.0'], sources: [[observed_sha256: 'fixture', logical_basename: 'reference.fa']], settings: [kmer_length: 31, smer_length: 9, fraction: 1.0, individual: false, positions: false]], file("\$baseDir/tests/data/sylph/reference.fa")]"""
                }
            }
        }

        when {
            workflow {
                """
                input[0] = channel.of(tuple(
                    [id: 'sample-a', platform: 'ont', single_end: true, read_set: 'input'],
                    [file("\$baseDir/tests/data/sylph/reads.fastq")],
                ))
                input[1] = BUILD_DEACON_INDEX.out.indexes.map { build, index ->
                    tuple(
                        [id: 'deacon-a', filter: [abs_threshold: 1, rel_threshold: 0.0, prefix_length: 0, complexity_threshold: null, deplete: false]],
                        index,
                    )
                }
                input[2] = channel.empty()
                input[3] = channel.empty()
                input[4] = BUILD_SKOPE_QUERY_INDEX.out.query_indexes.flatMap { build, queryIndex ->
                    [
                        tuple([id: 'skope-a', query: [fraction: 1.0, abundance_thresholds: [1], discriminatory: false, confidence: false, limit: null]], queryIndex),
                        tuple([id: 'skope-b', query: [fraction: 1.0, abundance_thresholds: [10], discriminatory: true, confidence: false, limit: null]], queryIndex),
                    ]
                }
                """
            }
        }

        then {
            def results = workflow.out.skope.collectEntries { meta, reference, result ->
                def readSet = meta.read_set == 'input' ? 'input' : "deacon:${meta.deacon_id}"
                [("${meta.id}:${readSet}:${reference.id}".toString()): [meta: meta, reference: reference, result: file(result)]]
            }
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().count { it.name.contains('FILTER_READS_WITH_DEACON') } == 1 },
                { assert workflow.trace.tasks().count { it.name.contains('QUERY_READS_WITH_SKOPE') } == 4 },
                {
                    assert results.keySet() == [
                        'sample-a:input:skope-a',
                        'sample-a:input:skope-b',
                        'sample-a:deacon:deacon-a:skope-a',
                        'sample-a:deacon:deacon-a:skope-b',
                    ] as Set
                },
                { assert results.values().every { output -> output.meta.id == 'sample-a' && output.reference.id.startsWith('skope-') } },
                { assert results.values()*.result*.name as Set == ['sample-a__input.skope.tsv', 'sample-a__deacon-deacon-a.skope.tsv'] as Set },
            )
        }
    }
}
