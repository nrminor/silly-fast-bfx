nextflow_process {
    name "Filter reads with Deacon process"
    script "../modules/local/filter_reads_with_deacon/main.nf"
    process "FILTER_READS_WITH_DEACON"
    tag "modules"
    tag "modules_local"

    test("retains a matching CBQ record and reports meaningful reads") {
        when {
            process {
                """input[0] = [[id: 'matching', platform: 'ont', read_set: 'input'], [id: 'reference-a', filter: [abs_threshold: 1, rel_threshold: 0.0, prefix_length: 0, complexity_threshold: null, deplete: false]], file("\$baseDir/tests/data/deacon/matching.cbq"), file("\$baseDir/tests/data/deacon/reference.k31w15.idx")]"""
            }
        }

        then {
            def output = process.out.reads[0]
            def reads = new java.util.zip.GZIPInputStream(file(output[2]).newInputStream()).text
            def summary = new groovy.json.JsonSlurper().parse(file(output[3]))
            assertAll(
                { assert process.success },
                { assert file(output[2]).name == 'matching.fastq.gz' },
                { assert output[4] == 'true' },
                { assert reads == file("${projectDir}/tests/data/deacon/matching.fastq").text },
                { assert summary.seqs_out == 1 },
            )
        }
    }

    test("preserves official zero-hit outputs") {
        when {
            process {
                """input[0] = [[id: 'nonmatching', platform: 'ont', read_set: 'input'], [id: 'reference-a', filter: [abs_threshold: 1, rel_threshold: 0.0, prefix_length: 0, complexity_threshold: null, deplete: false]], file("\$baseDir/tests/data/deacon/nonmatching.cbq"), file("\$baseDir/tests/data/deacon/reference.k31w15.idx")]"""
            }
        }

        then {
            def output = process.out.reads[0]
            def reads = new java.util.zip.GZIPInputStream(file(output[2]).newInputStream()).text
            def summary = new groovy.json.JsonSlurper().parse(file(output[3]))
            assertAll(
                { assert process.success },
                { assert file(output[2]).name == 'nonmatching.fastq.gz' },
                { assert output[4] == 'false' },
                { assert reads.isEmpty() },
                { assert summary.seqs_out == 0 },
            )
        }
    }

    test("filters a multifile CBQ into one FASTQ") {
        setup {
            [
                [file("$outputDir/first/reads.fastq.gz"), file("${projectDir}/tests/data/deacon/nonmatching.fastq")],
                [file("$outputDir/second/reads.fastq.gz"), file("${projectDir}/tests/data/deacon/matching.fastq")],
            ].each { target, source ->
                target.parentFile.mkdirs()
                new java.util.zip.GZIPOutputStream(target.newOutputStream()).withCloseable { gzip ->
                    gzip.write(source.bytes)
                }
            }
            run("ENCODE_READS_WITH_BQTOOLS") {
                script "../modules/local/encode_reads_with_bqtools/main.nf"
                process {
                    """input[0] = [[id: 'sample-a', platform: 'illumina', read_set: 'input'], [file("$outputDir/first/reads.fastq.gz"), file("$outputDir/second/reads.fastq.gz")]]"""
                }
            }
        }

        when {
            process {
                """
                input[0] = ENCODE_READS_WITH_BQTOOLS.out.encodings.map { meta, cbq ->
                    tuple(
                        meta,
                        [id: 'reference-a', filter: [abs_threshold: 1, rel_threshold: 0.0, prefix_length: 0, complexity_threshold: null, deplete: false]],
                        cbq,
                        file("\$baseDir/tests/data/deacon/reference.k31w15.idx"),
                    )
                }
                """
            }
        }

        then {
            def output = process.out.reads[0]
            def reads = new java.util.zip.GZIPInputStream(file(output[2]).newInputStream()).text
            assertAll(
                { assert process.success },
                { assert file(output[2]).name == 'sample-a.fastq.gz' },
                { assert reads == file("${projectDir}/tests/data/deacon/matching.fastq").text },
                { assert output[4] == 'true' },
            )
        }
    }

    test("stubs zero hits while preserving the official output tuple") {
        when {
            process {
                """input[0] = [[id: 'single', platform: 'ont', read_set: 'input'], [id: 'reference-a', filter: [abs_threshold: 2, rel_threshold: 0.01, prefix_length: 0, complexity_threshold: null, deplete: false]], file("\$baseDir/tests/data/deacon/matching.cbq"), file("\$baseDir/tests/data/deacon/reference.k31w15.idx")]"""
            }
            options '-stub-run'
        }

        then {
            def output = process.out.reads[0]
            assertAll(
                { assert process.success },
                { assert output[0] == [id: 'single', platform: 'ont', read_set: 'input'] },
                { assert output[1].id == 'reference-a' },
                { assert file(output[2]).name == 'single.fastq.gz' },
                { assert file(output[3]).text == '{"seqs_out": 0}\n' },
                { assert output[4] == 'false' },
            )
        }
    }
}
