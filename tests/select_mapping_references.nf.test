nextflow_workflow {
    name "Map read sets"
    script "../subworkflows/local/map_read_sets/main.nf"
    workflow "MAP_READ_SETS"
    tag "subworkflows"
    tag "subworkflows_local"

    test("routes profile selection by sample without cross-sample mapping") {
        when {
            workflow {
                """
                input[0] = channel.of(
                    tuple([id: 'sample-a', read_set: 'input'], [id: 'sylph-a'], file("\$baseDir/tests/data/sylph/selection.profile.tsv"), 'true'),
                    tuple([id: 'sample-b', read_set: 'input'], [id: 'sylph-a'], file("\$baseDir/tests/data/sylph/selection.profile.tsv"), 'true'),
                    tuple([id: 'sample-a', read_set: 'deacon_filtered', deacon_id: 'host'], [id: 'sylph-a'], file("\$baseDir/tests/data/sylph/selection.profile.tsv"), 'true'),
                )
                 input[1] = channel.empty()
                 input[2] = channel.of(
                    tuple([id: 'mapping-input', profile: [reference: 'sylph-a', read_set: [input: true]], read_sets: [input: true], select: [sequence_abundance: [min: 55, max: null], adjusted_ani: [min: null, max: null]]], file("\$baseDir/tests/data/sylph/selection-reference.fa")),
                    tuple([id: 'mapping-filtered', profile: [reference: 'sylph-a', read_set: [deacon_filtered: 'host']], read_sets: [input: true], select: [sequence_abundance: [min: 55, max: null], adjusted_ani: [min: null, max: null]]], file("\$baseDir/tests/data/sylph/selection-reference.fa")),
                 )
                 input[3] = channel.empty()
                """
            }
        }

        then {
            def selected = workflow.out.selected.collect { meta, reference, fasta, profile ->
                "${meta.id}:${meta.read_set}:${meta.deacon_id ?: '-'}:${reference.id}".toString()
            } as Set
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().count { it.name.contains('SUBSET_MAPPING_REFERENCE') } == 3 },
                { assert selected == ['sample-a:input:-:mapping-input', 'sample-b:input:-:mapping-input', 'sample-a:deacon_filtered:host:mapping-filtered'] as Set },
            )
        }
    }

    test("publishes an empty-selection report but emits no selected reference") {
        when {
            workflow {
                """
                input[0] = channel.of(tuple([id: 'sample-a', read_set: 'input'], [id: 'sylph-a'], file("\$baseDir/tests/data/sylph/selection-token.profile.tsv"), 'true'))
                 input[1] = channel.empty()
                 input[2] = channel.of(tuple([id: 'mapping-a', profile: [reference: 'sylph-a', read_set: [input: true]], read_sets: [input: true], select: [sequence_abundance: [min: null, max: null], adjusted_ani: [min: null, max: null]]], file("\$baseDir/tests/data/sylph/selection-reference.fa")))
                 input[3] = channel.empty()
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.reports.size() == 1 },
                { assert workflow.out.selected.isEmpty() },
                { assert workflow.stdout.join('\n').contains('WARN: No mapping reference records selected') },
            )
        }
    }

    test("reuses one mapped read set while rendering pileups only for enabled references") {
        when {
            workflow {
                """
                input[0] = channel.of(tuple([id: 'sample-a', platform: 'illumina', read_set: 'input'], [id: 'sylph-a'], file("\$baseDir/tests/data/mapping/selection.profile.tsv"), 'true'))
                input[1] = channel.of(tuple([id: 'sample-a', platform: 'illumina', read_set: 'input'], [file("\$baseDir/tests/data/mapping/ambiguous.fastq")]))
                input[2] = channel.of(
                    tuple([id: 'mapping-a', profile: [reference: 'sylph-a', read_set: [input: true]], read_sets: [input: true], select: [sequence_abundance: [min: null, max: null], adjusted_ani: [min: null, max: null]], align: [ont: [preset: 'map-ont', max_secondary: 5, secondary_score_ratio: 0.8], illumina: [preset: 'sr', max_secondary: 20, secondary_score_ratio: 0.5]]], file("\$baseDir/tests/data/mapping/ambiguous-reference.fa")),
                    tuple([id: 'mapping-b', profile: [reference: 'sylph-a', read_set: [input: true]], read_sets: [input: true], select: [sequence_abundance: [min: null, max: null], adjusted_ani: [min: null, max: null]], align: [ont: [preset: 'map-ont', max_secondary: 5, secondary_score_ratio: 0.8], illumina: [preset: 'sr', max_secondary: 20, secondary_score_ratio: 0.5]], pileups: [enabled: false], read_store: [enabled: false]], file("\$baseDir/tests/data/mapping/ambiguous-reference.fa")),
                    tuple([id: 'mapping-c', profile: [reference: 'sylph-a', read_set: [input: true]], read_sets: [input: true], select: [sequence_abundance: [min: null, max: null], adjusted_ani: [min: null, max: null]], align: [ont: [preset: 'map-ont', max_secondary: 5, secondary_score_ratio: 0.8], illumina: [preset: 'sr', max_secondary: 20, secondary_score_ratio: 0.5]], pileups: [enabled: true]], file("\$baseDir/tests/data/mapping/ambiguous-reference.fa")),
                 )
                 input[3] = channel.empty()
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().count { it.name.contains('PREPARE_MAPPING_IDENTITIES') } == 1 },
                { assert workflow.trace.tasks().count { it.name.contains('MAP_READS_WITH_MINIMAP2') } == 3 },
                { assert workflow.trace.tasks().count { it.name.contains('RENDER_MAPPING_PILEUPS_WITH_ALIGNOTH') } == 1 },
                { assert workflow.trace.tasks().count { it.name.contains('STORE_CLASSIFIED_READS') } == 2 },
                { assert workflow.out.classified_reads.collect { meta, reference, store -> reference.id } as Set == ['mapping-a', 'mapping-c'] as Set },
                { assert workflow.out.alignments.collect { meta, reference, fasta, profile, bam, csi, counts -> reference.id } as Set == ['mapping-a', 'mapping-b', 'mapping-c'] as Set },
                { assert workflow.out.pileups.collect { meta, reference, pileups -> reference.id } == ['mapping-c'] },
            )
        }
    }
}
