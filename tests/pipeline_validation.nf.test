nextflow_pipeline {
    name "Validate pipeline parameters"
    script "../main.nf"
    tag "pipeline"
    tag "validation"

    test("ordinary runs require a samplesheet") {
        when {
            params {
                results = "$outputDir"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stderr.join('\n').contains("/input")
        }
    }

    test("unknown root parameters are rejected") {
        when {
            params {
                input = "/tmp/not-read.csv"
                misspelled_parameter = true
            }
        }

        then {
            assert workflow.failed
            assert workflow.stderr.join('\n').contains("misspelled_parameter")
        }
    }

    test("malformed nested artifact sources are rejected") {
        when {
            params {
                input = "/tmp/not-read.csv"
                skip_deacon = true
                deacon = [
                    references: [[
                        id: "reference-a",
                        fasta: [kind: "local", url: "https://example.org/reference.fasta"],
                    ]],
                ]
            }
        }

        then {
            assert workflow.failed
            assert workflow.stderr.join('\n').contains("path")
        }
    }

    test("search references accept explicit read-set selections") {
        setup {
            def samplesheet = file("$outputDir/exact.csv")
            samplesheet.parentFile.mkdirs()
            samplesheet.text = [
                "sample_id,srr,platform,fastq1,fastq2",
                "sample-a,,illumina,${projectDir}/tests/data/fastq/single.fastq,",
            ].join('\n') + '\n'
        }

        when {
            params {
                input = "$outputDir/exact.csv"
                skip_sylph = true
                skip_skope = true
                sylph = [
                    references: [[
                        id: "sylph-a",
                        database: [kind: "https", url: "https://example.org/reference.syldb"],
                        read_sets: [input: false, deacon_filtered: ["deacon-a"]],
                    ]],
                ]
                skope = [
                    references: [[
                        id: "skope-a",
                        query_index: [kind: "https", url: "https://example.org/reference.sk"],
                        read_sets: [input: true, deacon_filtered: []],
                    ]],
                ]
            }
        }

        then {
            assert workflow.success
        }
    }

    test("search references must select at least one read set") {
        when {
            params {
                input = "/tmp/not-read.csv"
                skip_sylph = true
                sylph = [
                    references: [[
                        id: "sylph-a",
                        database: [kind: "https", url: "https://example.org/reference.syldb"],
                        read_sets: [input: false, deacon_filtered: []],
                    ]],
                ]
            }
        }

        then {
            assert workflow.failed
            assert workflow.stderr.join('\n').contains("read_sets")
        }
    }

    test("every user-facing schema property provides hover documentation") {
        setup {
            def samplesheet = file("$outputDir/exact.csv")
            samplesheet.parentFile.mkdirs()
            samplesheet.text = [
                "sample_id,srr,platform,fastq1,fastq2",
                "sample-a,,illumina,${projectDir}/tests/data/fastq/single.fastq,",
            ].join('\n') + '\n'
        }

        when {
            params {
                input = "$outputDir/exact.csv"
                results = "$outputDir/results"
            }
        }

        then {
            def schema = new groovy.json.JsonSlurper().parse(file("${projectDir}/nextflow_schema.json"))
            def missing = []
            def inspect
            inspect = { node, path ->
                (node.properties ?: [:]).each { name, property ->
                    def propertyPath = path ? "${path}.${name}" : name
                    if (!(path == '' && property.hidden) && !property.description) {
                        missing << propertyPath
                    }
                    inspect(property, propertyPath)
                }
                (node.'$defs' ?: [:]).each { name, definition ->
                    inspect(definition, "\$defs.${name}")
                }
                (node.oneOf ?: []).eachWithIndex { branch, index ->
                    inspect(branch, "${path}.oneOf[${index}]")
                }
            }
            inspect(schema, '')

            assertAll(
                { assert workflow.success },
                { assert missing.isEmpty(): "Missing schema descriptions: ${missing.join(', ')}" },
            )
        }
    }

    test("duplicate reference IDs are rejected by the parameter schema") {
        setup {
            def samplesheet = file("$outputDir/exact.csv")
            samplesheet.parentFile.mkdirs()
            samplesheet.text = [
                "sample_id,srr,platform,fastq1,fastq2",
                "sample-a,,illumina,${projectDir}/tests/data/fastq/single.fastq,",
            ].join('\n') + '\n'
        }

        when {
            params {
                input = "$outputDir/exact.csv"
                skip_deacon = true
                deacon = [
                    references: [
                        [id: "duplicate", index: [kind: "local", path: "${projectDir}/tests/data/deacon/reference.k31w15.idx"]],
                        [id: "duplicate", index: [kind: "local", path: "${projectDir}/tests/data/deacon/reference.k31w15.idx"], filter: [abs_threshold: 3]],
                    ],
                ]
            }
        }

        then {
            assert workflow.failed
            assert workflow.stderr.join('\n').contains("duplicate")
        }
    }

    test("an enabled Deacon reference screens exact-local reads") {
        setup {
            def samplesheet = file("$outputDir/deacon.csv")
            samplesheet.parentFile.mkdirs()
            samplesheet.text = [
                "sample_id,srr,platform,fastq1,fastq2",
                "sample-a,,nanopore,${projectDir}/tests/data/deacon/matching.fastq,",
            ].join('\n') + '\n'
        }

        when {
            params {
                input = "$outputDir/deacon.csv"
                deacon = [
                    references: [[
                        id: "reference-a",
                        index: [kind: "local", path: "${projectDir}/tests/data/deacon/reference.k31w15.idx"],
                        filter: [abs_threshold: 1, rel_threshold: 0.0],
                    ]],
                ]
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().count { it.name.contains('ENCODE_READS_WITH_BQTOOLS') } == 1 },
                { assert workflow.trace.tasks().count { it.name.contains('FILTER_READS_WITH_DEACON') } == 1 },
                { assert workflow.trace.tasks().count { it.name.contains('BUILD_DEACON_INDEX') } == 0 },
            )
        }
    }

    test("equivalent exact and grouped inputs preserve downstream task cardinality") {
        setup {
            def samplesheet = file("$outputDir/deacon-grouped.csv")
            def laneOne = file("$outputDir/grouped_L001_R1_001.fastq")
            def laneTwo = file("$outputDir/grouped_L002_R1_001.fastq")
            samplesheet.parentFile.mkdirs()
            laneOne.bytes = file("${projectDir}/tests/data/deacon/matching.fastq").bytes
            laneTwo.bytes = file("${projectDir}/tests/data/deacon/matching.fastq").bytes
            samplesheet.text = [
                "sample_id,srr,platform,fastq1,fastq2,fastq1_glob,fastq2_glob",
                "exact,,nanopore,${projectDir}/tests/data/deacon/matching.fastq,,,",
                "grouped,,nanopore,,,$outputDir/grouped_L*_R1_001.fastq,",
            ].join('\n') + '\n'
        }

        when {
            params {
                input = "$outputDir/deacon-grouped.csv"
                deacon = [
                    references: [[
                        id: "reference-a",
                        index: [kind: "local", path: "${projectDir}/tests/data/deacon/reference.k31w15.idx"],
                        filter: [abs_threshold: 1, rel_threshold: 0.0],
                    ]],
                ]
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().count { it.name.contains('COLLATE_FASTQ') } == 1 },
                { assert workflow.trace.tasks().count { it.name.contains('ENCODE_READS_WITH_BQTOOLS') } == 2 },
                { assert workflow.trace.tasks().count { it.name.contains('FILTER_READS_WITH_DEACON') } == 2 },
            )
        }
    }

    test("a source-built Deacon reference reaches screening") {
        setup {
            def samplesheet = file("$outputDir/deacon-source.csv")
            samplesheet.parentFile.mkdirs()
            samplesheet.text = [
                "sample_id,srr,platform,fastq1,fastq2",
                "sample-a,,nanopore,${projectDir}/tests/data/deacon/matching.fastq,",
            ].join('\n') + '\n'
        }

        when {
            params {
                input = "$outputDir/deacon-source.csv"
                deacon = [
                    references: [[
                        id: "reference-a",
                        fasta: [kind: "local", path: "${projectDir}/tests/data/deacon/reference.fa"],
                        filter: [abs_threshold: 1, rel_threshold: 0.0],
                    ]],
                ]
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().count { it.name.contains('BUILD_DEACON_INDEX') } == 1 },
                { assert workflow.trace.tasks().count { it.name.contains('ENCODE_READS_WITH_BQTOOLS') } == 1 },
                { assert workflow.trace.tasks().count { it.name.contains('FILTER_READS_WITH_DEACON') } == 1 },
            )
        }
    }

    test("source-built Sylph references keep compatible databases and sample sketches attached") {
        setup {
            def samplesheet = file("$outputDir/sylph-source.csv")
            samplesheet.parentFile.mkdirs()
            samplesheet.text = [
                "sample_id,srr,platform,fastq1,fastq2",
                "sample-a,,nanopore,${projectDir}/tests/data/sylph/reads.fastq,",
            ].join('\n') + '\n'
        }

        when {
            params {
                input = "$outputDir/sylph-source.csv"
                sylph = [
                    references: [
                        [
                            id: "reference-k31",
                            read_sets: [input: true, deacon_filtered: []],
                            fastas: [[kind: "local", path: "${projectDir}/tests/data/sylph/reference.fa"]],
                            build: [kmer_length: 31, compression: 2, min_spacing: 2],
                            sample_sketch: [kmer_length: 31, compression: 2],
                            profile: [min_count_correct: 1, min_number_kmers: 1],
                        ],
                        [
                            id: "reference-k21",
                            read_sets: [input: true, deacon_filtered: []],
                            fastas: [[kind: "local", path: "${projectDir}/tests/data/sylph/reference.fa"]],
                            build: [kmer_length: 21, compression: 2, min_spacing: 2],
                            sample_sketch: [kmer_length: 21, compression: 2],
                            profile: [min_count_correct: 1, min_number_kmers: 1],
                        ],
                    ],
                ]
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().count { it.name.contains('BUILD_SYLPH_DATABASE') } == 2 },
                { assert workflow.trace.tasks().count { it.name.contains('SKETCH_READS_WITH_SYLPH') } == 2 },
                { assert workflow.trace.tasks().count { it.name.contains('PROFILE_READS_WITH_SYLPH') } == 2 },
                { assert workflow.trace.tasks().count { it.name.contains('SUMMARIZE_SYLPH_TAXONOMY') } == 0 },
            )
        }
    }

    test("configured Sylph taxonomy reaches one meaningful raw profile") {
        setup {
            def samplesheet = file("$outputDir/sylph-taxonomy.csv")
            samplesheet.parentFile.mkdirs()
            samplesheet.text = [
                "sample_id,srr,platform,fastq1,fastq2",
                "sample-a,,nanopore,${projectDir}/tests/data/sylph/reads.fastq,",
            ].join('\n') + '\n'
        }

        when {
            params {
                input = "$outputDir/sylph-taxonomy.csv"
                sylph = [
                    references: [[
                        id: "reference-a",
                        read_sets: [input: true, deacon_filtered: []],
                        fastas: [[kind: "local", path: "${projectDir}/tests/data/sylph/reference.fa"]],
                        build: [kmer_length: 31, compression: 2, min_spacing: 2],
                        sample_sketch: [kmer_length: 31, compression: 2],
                        profile: [min_count_correct: 1, min_number_kmers: 1],
                        taxonomy: [metadata: [[kind: "local", path: "${projectDir}/tests/data/sylph/taxonomy-a.tsv"]]],
                    ]],
                ]
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().count { it.name.contains('PROFILE_READS_WITH_SYLPH') } == 1 },
                { assert workflow.trace.tasks().count { it.name.contains('SUMMARIZE_SYLPH_TAXONOMY') } == 1 },
            )
        }
    }

    test("a source-built Skope reference reaches input-read screening") {
        setup {
            def samplesheet = file("$outputDir/skope-source.csv")
            samplesheet.parentFile.mkdirs()
            samplesheet.text = [
                "sample_id,srr,platform,fastq1,fastq2",
                "sample-a,,nanopore,${projectDir}/tests/data/sylph/reads.fastq,",
            ].join('\n') + '\n'
        }

        when {
            params {
                input = "$outputDir/skope-source.csv"
                skope = [
                    references: [[
                        id: "reference-a",
                        read_sets: [input: true, deacon_filtered: []],
                        targets: [kind: "local", path: "${projectDir}/tests/data/sylph/reference.fa"],
                        query: [abundance_thresholds: [1], confidence: true],
                    ]],
                ]
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().count { it.name.contains('BUILD_SKOPE_QUERY_INDEX') } == 1 },
                { assert workflow.trace.tasks().count { it.name.contains('QUERY_READS_WITH_SKOPE') } == 1 },
                { assert workflow.trace.tasks().every { !it.name.contains('ENCODE_READS_WITH_BQTOOLS') } },
            )
        }
    }

    test("the entry workflow rejects a missing samplesheet") {
        when {
            params {
                input = "/tmp/silly-fast-bfx-missing-samplesheet.csv"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stderr.join('\n').contains("does not exist")
        }
    }

    test("an exact-local run without references publishes pipeline provenance") {
        setup {
            def samplesheet = file("$outputDir/exact.csv")
            samplesheet.parentFile.mkdirs()
            samplesheet.text = [
                "sample_id,srr,platform,fastq1,fastq2",
                "sample-a,,illumina,${projectDir}/tests/data/fastq/single.fastq,",
            ].join('\n') + '\n'
        }

        when {
            params {
                input = "$outputDir/exact.csv"
                results = "$outputDir/results"
            }
        }

        then {
            def pipelineInfo = file("$outputDir/results/pipeline_info")
            assertAll(
                { assert workflow.success },
                { assert file("$pipelineInfo/samplesheet.csv").text == file("$outputDir/exact.csv").text },
                { assert file("$pipelineInfo/software_versions.yml").text.contains('Workflow:') },
                { assert file("$pipelineInfo/execution_report.html").exists() },
                { assert file("$pipelineInfo/execution_timeline.html").exists() },
                { assert file("$pipelineInfo/pipeline_dag.html").exists() },
            )
        }
    }

    test("a skip flag overrides configured references") {
        setup {
            def samplesheet = file("$outputDir/exact.csv")
            samplesheet.parentFile.mkdirs()
            samplesheet.text = [
                "sample_id,srr,platform,fastq1,fastq2",
                "sample-a,,illumina,${projectDir}/tests/data/fastq/single.fastq,",
            ].join('\n') + '\n'
        }

        when {
            params {
                input = "$outputDir/exact.csv"
                skip_deacon = true
                deacon = [
                    references: [[
                        id: "reference-a",
                        index: [kind: "https", url: "https://example.org/reference.idx"],
                    ]],
                ]
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().every { task ->
                !task.name.contains('PREPARE_REFERENCES') && !task.name.contains('SCREEN_READ_SETS')
            }
        }
    }

    test("skip_sylph suppresses only Sylph while Deacon still screens") {
        setup {
            def samplesheet = file("$outputDir/skip-sylph.csv")
            samplesheet.parentFile.mkdirs()
            samplesheet.text = [
                "sample_id,srr,platform,fastq1,fastq2",
                "sample-a,,nanopore,${projectDir}/tests/data/deacon/matching.fastq,",
            ].join('\n') + '\n'
        }

        when {
            params {
                input = "$outputDir/skip-sylph.csv"
                skip_sylph = true
                deacon = [
                    references: [[
                        id: "deacon-a",
                        index: [kind: "local", path: "${projectDir}/tests/data/deacon/reference.k31w15.idx"],
                        filter: [abs_threshold: 1, rel_threshold: 0.0],
                    ]],
                ]
                sylph = [
                    references: [[
                        id: "sylph-a",
                        read_sets: [input: true, deacon_filtered: []],
                        database: [kind: "https", url: "https://fixtures.invalid/reference.syldb"],
                    ]],
                ]
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().count { it.name.contains('ENCODE_READS_WITH_BQTOOLS') } == 1 },
                { assert workflow.trace.tasks().count { it.name.contains('FILTER_READS_WITH_DEACON') } == 1 },
                { assert workflow.trace.tasks().every { !it.name.contains('BUILD_SYLPH_DATABASE') } },
                { assert workflow.trace.tasks().every { !it.name.contains('SKETCH_READS_WITH_SYLPH') } },
                { assert workflow.trace.tasks().every { !it.name.contains('PROFILE_READS_WITH_SYLPH') } },
            )
        }
    }

    test("skip_skope suppresses only Skope while Sylph still screens") {
        setup {
            def samplesheet = file("$outputDir/skip-skope.csv")
            samplesheet.parentFile.mkdirs()
            samplesheet.text = [
                "sample_id,srr,platform,fastq1,fastq2",
                "sample-a,,nanopore,${projectDir}/tests/data/sylph/reads.fastq,",
            ].join('\n') + '\n'
        }

        when {
            params {
                input = "$outputDir/skip-skope.csv"
                skip_skope = true
                sylph = [
                    references: [[
                        id: "sylph-a",
                        read_sets: [input: true, deacon_filtered: []],
                        fastas: [[kind: "local", path: "${projectDir}/tests/data/sylph/reference.fa"]],
                        build: [kmer_length: 31, compression: 2, min_spacing: 2],
                        sample_sketch: [kmer_length: 31, compression: 2],
                        profile: [min_count_correct: 1, min_number_kmers: 1],
                    ]],
                ]
                skope = [
                    references: [[
                        id: "skope-a",
                        read_sets: [input: true, deacon_filtered: []],
                        query_index: [kind: "https", url: "https://fixtures.invalid/reference.sk"],
                    ]],
                ]
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().count { it.name.contains('BUILD_SYLPH_DATABASE') } == 1 },
                { assert workflow.trace.tasks().count { it.name.contains('SKETCH_READS_WITH_SYLPH') } == 1 },
                { assert workflow.trace.tasks().count { it.name.contains('PROFILE_READS_WITH_SYLPH') } == 1 },
                { assert workflow.trace.tasks().every { !it.name.contains('DOWNLOAD_REFERENCE') } },
                { assert workflow.trace.tasks().every { !it.name.contains('BUILD_SKOPE_QUERY_INDEX') } },
                { assert workflow.trace.tasks().every { !it.name.contains('QUERY_READS_WITH_SKOPE') } },
            )
        }
    }

    test("partial nested overrides accept the pinned tools' numeric types") {
        setup {
            def samplesheet = file("$outputDir/exact.csv")
            samplesheet.parentFile.mkdirs()
            samplesheet.text = [
                "sample_id,srr,platform,fastq1,fastq2",
                "sample-a,,illumina,${projectDir}/tests/data/fastq/single.fastq,",
            ].join('\n') + '\n'
        }

        when {
            params {
                input = "$outputDir/exact.csv"
                skip_sylph = true
                deacon = [:]
                sylph = [
                    references: [[
                        id: "reference-a",
                        read_sets: [input: true, deacon_filtered: []],
                        database: [kind: "https", url: "https://example.org/reference.syldb"],
                        sample_sketch: [no_dedup: true, fpr: 0.0],
                        profile: [
                            min_count_correct: 2.5,
                            min_number_kmers: 50.5,
                            estimate_unknown: true,
                            estimate_read_counts: true,
                            read_seq_id: 99.5,
                        ],
                    ]],
                ]
                skope = [references: []]
            }
        }

        then {
            assert workflow.success
        }
    }

    test("hidden Sylph profiling controls are rejected") {
        setup {
            def samplesheet = file("$outputDir/exact.csv")
            samplesheet.parentFile.mkdirs()
            samplesheet.text = [
                "sample_id,srr,platform,fastq1,fastq2",
                "sample-a,,illumina,${projectDir}/tests/data/fastq/single.fastq,",
            ].join('\n') + '\n'
        }

        when {
            params {
                input = "$outputDir/exact.csv"
                skip_sylph = true
                deacon = [:]
                sylph = [
                    references: [[
                        id: "reference-a",
                        read_sets: [input: true, deacon_filtered: []],
                        database: [kind: "https", url: "https://example.org/reference.syldb"],
                        profile: [redundant_ani: 99],
                    ]],
                ]
                skope = [references: []]
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("zero read sequence identity is rejected") {
        setup {
            def samplesheet = file("$outputDir/exact.csv")
            samplesheet.parentFile.mkdirs()
            samplesheet.text = [
                "sample_id,srr,platform,fastq1,fastq2",
                "sample-a,,illumina,${projectDir}/tests/data/fastq/single.fastq,",
            ].join('\n') + '\n'
        }

        when {
            params {
                input = "$outputDir/exact.csv"
                skip_sylph = true
                deacon = [:]
                sylph = [
                    references: [[
                        id: "reference-a",
                        read_sets: [input: true, deacon_filtered: []],
                        database: [kind: "https", url: "https://example.org/reference.syldb"],
                        profile: [read_seq_id: 0],
                    ]],
                ]
                skope = [references: []]
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("the example params YAML validates through the entry workflow") {
        setup {
            def samplesheet = file("$outputDir/exact.csv")
            def params_file = file("$outputDir/params.example.yaml")
            samplesheet.parentFile.mkdirs()
            samplesheet.text = [
                "sample_id,srr,platform,fastq1,fastq2",
                "sample-a,,illumina,${projectDir}/tests/data/fastq/single.fastq,",
            ].join('\n') + '\n'
            params_file.text = file("${projectDir}/assets/params.example.yaml")
                .readLines()
                .findAll { line -> !line.startsWith('# yaml-language-server:') }
                .join('\n') + '\n'
        }

        when {
            params {
                load("$outputDir/params.example.yaml")
                input = "$outputDir/exact.csv"
                results = "$outputDir/results"
            }
        }

        then {
            assert workflow.success
        }
    }

    test("a params YAML cannot select both sides of a source variant") {
        setup {
            def params_file = file("$outputDir/invalid-params.yaml")
            params_file.parentFile.mkdirs()
            params_file.text = """\
input: /tmp/not-read.csv
skip_deacon: true
deacon:
  references:
    - id: reference-a
      fasta:
        kind: local
        path: /tmp/reference.fasta
      index:
        kind: https
        url: https://example.org/reference.idx
"""
        }

        when {
            params {
                load("$outputDir/invalid-params.yaml")
            }
        }

        then {
            assert workflow.failed
            assert workflow.stderr.join('\n').contains("/deacon/references/0")
        }
    }

}
